"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},"1g8rmn3",{"filePath":"67","messages":"68","suppressedMessages":"69","errorCount":0,"fatalErrorCount":0,"warningCount":2,"fixableErrorCount":0,"fixableWarningCount":0,"source":null},{"filePath":"70","messages":"71","suppressedMessages":"72","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"41"},{"filePath":"73","messages":"74","suppressedMessages":"75","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"41"},{"filePath":"76","messages":"77","suppressedMessages":"78","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},"ypkfdh",{"filePath":"79","messages":"80","suppressedMessages":"81","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},{"filePath":"82","messages":"83","suppressedMessages":"84","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},{"filePath":"85","messages":"86","suppressedMessages":"87","errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":null},"/Users/haraldpaaske/random/botsystem/botsystem/src/index.js",[],[],[],"/Users/haraldpaaske/random/botsystem/botsystem/src/App.js",[],[],"/Users/haraldpaaske/random/botsystem/botsystem/src/reportWebVitals.js",[],[],"/Users/haraldpaaske/random/botsystem/botsystem/src/components/melding/Done.js",[],[],"/Users/haraldpaaske/random/botsystem/botsystem/src/components/navbar/Navbar.js",[],[],"/Users/haraldpaaske/random/botsystem/botsystem/src/components/reglement/Reglement.js",[],[],"/Users/haraldpaaske/random/botsystem/botsystem/src/components/bug_report/BugReport.js",["88"],[],"// BugReport.js\n\nimport React, { useState, useEffect } from \"react\";\nimport { ref, onValue, off, set } from \"firebase/database\";\nimport { db } from \"../../firebaseConfig\";\nimport \"./BugReport.css\";\n\nconst BugReport = () => {\n  const [inputText, setInputText] = useState(\"\");\n  const [bugReports, setBugReports] = useState([]);\n\n  useEffect(() => {\n    const dbRef = ref(db, \"bugReports\");\n\n    const handleDataChange = (snapshot) => {\n      if (snapshot && snapshot.val()) {\n        const data = snapshot.val();\n        setBugReports(data || []);\n      }\n    };\n\n    onValue(dbRef, handleDataChange);\n    return () => {\n      off(dbRef, handleDataChange);\n    };\n  }, []);\n\n  const handleSubmit = async (e) => {\n    e.preventDefault();\n    try {\n      const newBugId = bugReports.length;\n\n      const bugReport = {\n        id: newBugId,\n        text: inputText,\n        fixed: false,\n      };\n\n      const bugReportRef = ref(db, `bugReports/${newBugId}`);\n      await set(bugReportRef, bugReport);\n\n      console.log(\"Bug report submitted successfully!\");\n      setInputText(\"\");\n      setBugReports([...bugReports, bugReport]);\n    } catch (error) {\n      console.error(\"Failed to submit bug report:\", error.message);\n    }\n  };\n\n  const handleFixChange = async (bugId) => {\n    try {\n      const bugReportsCopy = [...bugReports];\n      const bugIndex = bugReportsCopy.findIndex((bug) => bug.id === bugId);\n\n      if (bugIndex !== -1) {\n        const updatedBug = {\n          ...bugReportsCopy[bugIndex],\n          fixed: !bugReportsCopy[bugIndex].fixed,\n        };\n\n        const bugReportRef = ref(db, `bugReports/${bugId}`);\n        await set(bugReportRef, updatedBug);\n\n        bugReportsCopy[bugIndex] = updatedBug;\n        setBugReports(bugReportsCopy);\n      }\n    } catch (error) {\n      console.error(\"Failed to update bug report:\", error.message);\n    }\n  };\n\n  return (\n    <div className=\"bug-report-container\">\n      <div className=\"bug-report-form\">\n        <form onSubmit={handleSubmit}>\n          <label>\n            <h2>Submit desired feature:</h2>\n            <textarea\n              value={inputText}\n              onChange={(e) => setInputText(e.target.value)}\n              rows=\"6\"\n              cols=\"50\"\n              required\n            />\n          </label>\n          <br />\n          <button type=\"submit\">Submit Request</button>\n        </form>\n      </div>\n      <br />\n      <p className=\"special-paragraphs\">✅→ ferdig</p>\n      <p className=\"special-paragraphs\">❌→ er på sak</p>\n\n      <div className=\"bug-list-container\">\n        <ul className=\"bug-list\">\n          {bugReports\n            .slice()\n            .reverse()\n            .map((bugReport) => (\n              <li\n                key={bugReport.id}\n                className={bugReport.fixed ? \"fixed\" : \"not-fixed\"}\n              >\n                <p>{bugReport.text}</p>\n              </li>\n            ))}\n        </ul>\n      </div>\n    </div>\n  );\n};\n\nexport default BugReport;\n","/Users/haraldpaaske/random/botsystem/botsystem/src/components/oversikt/Oversikt.js",["89","90","91","92"],[],"/Users/haraldpaaske/random/botsystem/botsystem/src/components/melding/Melding.js",[],[],"/Users/haraldpaaske/random/botsystem/botsystem/src/components/arkiv/Arkiv.js",["93","94"],[],"/Users/haraldpaaske/random/botsystem/botsystem/src/components/bug_report/FeedbackMottatt.js",[],[],"/Users/haraldpaaske/random/botsystem/botsystem/src/firebaseConfig.js",[],[],"/Users/haraldpaaske/random/botsystem/botsystem/src/hooks/usePlayers.js",[],[],"/Users/haraldpaaske/random/botsystem/botsystem/src/hooks/fetchRules.js",[],[],"/Users/haraldpaaske/random/botsystem/botsystem/src/components/oversikt/RedigerSpillere.js",[],[],"/Users/haraldpaaske/random/botsystem/botsystem/src/components/oversikt/StyringsBot.js",["95"],[],{"ruleId":"96","severity":1,"message":"97","line":50,"column":9,"nodeType":"98","messageId":"99","endLine":50,"endColumn":24},{"ruleId":"96","severity":1,"message":"100","line":36,"column":10,"nodeType":"98","messageId":"99","endLine":36,"endColumn":22},{"ruleId":"96","severity":1,"message":"101","line":37,"column":10,"nodeType":"98","messageId":"99","endLine":37,"endColumn":23},{"ruleId":"96","severity":1,"message":"102","line":38,"column":9,"nodeType":"98","messageId":"99","endLine":38,"endColumn":13},{"ruleId":"96","severity":1,"message":"103","line":263,"column":9,"nodeType":"98","messageId":"99","endLine":263,"endColumn":29},{"ruleId":"96","severity":1,"message":"104","line":18,"column":9,"nodeType":"98","messageId":"99","endLine":18,"endColumn":14},{"ruleId":"105","severity":1,"message":"106","line":41,"column":6,"nodeType":"107","endLine":41,"endColumn":33,"suggestions":"108"},{"ruleId":"96","severity":1,"message":"104","line":11,"column":9,"nodeType":"98","messageId":"99","endLine":11,"endColumn":14},"no-unused-vars","'handleFixChange' is assigned a value but never used.","Identifier","unusedVar","'jsonDataFull' is assigned a value but never used.","'jsonDataBoter' is assigned a value but never used.","'dato' is assigned a value but never used.","'handleRegistrerBoter' is assigned a value but never used.","'rules' is assigned a value but never used.","react-hooks/exhaustive-deps","React Hook useEffect has a missing dependency: 'filterData'. Either include it or remove the dependency array.","ArrayExpression",["109"],{"desc":"110","fix":"111"},"Update the dependencies array to be: [filterCriteria, arkivData, filterData]",{"range":"112","text":"113"},[1068,1095],"[filterCriteria, arkivData, filterData]"]